# Copy this file to .env and replace every placeholder.
# Never commit .env. Generate a real SECRET_KEY before running the app:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"

SECRET_KEY=change-me-generate-a-long-random-value

# Local development only. Production must set DEBUG=False.
DEBUG=True

# Comma-separated hosts. No wildcard when DEBUG=False.
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated browser origins. Leave CORS_ALLOW_ALL_ORIGINS false.
# A wildcard is rejected when DEBUG=False.
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CORS_ALLOW_ALL_ORIGINS=False

# Database. SQLite is the local default and does not use a password.
# For PostgreSQL set DB_ENGINE=django.db.backends.postgresql and fill the rest.
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=

# Used only by seed/admin scripts. Replace before creating any accounts.
ADMIN_PASSWORD=change-me
TEST_USER_PASSWORD=change-me

# SMTP. Leave blank to skip real email sending.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Optional third-party keys.
OPENROUTE_SERVICE_API_KEY=
GOOGLE_MAPS_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_FILE=
ADMIN_GOOGLE_OAUTH_TOKEN=
ADMIN_GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE=
GOOGLE_DRIVE_FOLDER_ID=
